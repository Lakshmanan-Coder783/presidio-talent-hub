NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/presidio_talent_hub

# Session signing secret (generate a long random string)
JWT_SECRET=

# Filled in during the auth phase (Azure AD app registration)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/entra/callback

# Filled in during the email phase (Microsoft 365 mailbox, SMTP AUTH must be
# enabled for this mailbox in the Microsoft 365 admin center)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

APP_PUBLIC_URL=http://localhost:5173
